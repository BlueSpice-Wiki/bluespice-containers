#Raise ServerLimits ERM#44157
	fastcgi_read_timeout 600;
    proxy_read_timeout 600;

server {
	server_name _;
	listen 9090 default_server;
	root /app/bluespice;
	client_max_body_size ###MAX_UPLOAD_SIZE|1024m###;
	access_log /proc/1/fd/1;
	error_log /proc/1/fd/2 ###WIKI_LOG_LEVEL###;
	server_tokens off;

	# /.well-known/* (RFC 8615 requires these at the server root, e.g.
	# /.well-known/jwks.json for JWT key discovery) is served by the MediaWiki
	# REST API. A plain rewrite to /w/rest.php/.well-known/... is NOT enough,
	# for two reasons:
	#  - PHP's REQUEST_URI comes from $request_uri, which always holds the
	#    ORIGINAL client URI (internal rewrites never change it), and MediaWiki
	#    resolves REST routes from REQUEST_URI, so it must look like
	#    /w/rest.php/.well-known/...
	#  - the farm dispatcher needs sfr=<instance> in the query string,
	#    otherwise it answers "302 /w" before the REST router even runs.
	# Both are therefore forged explicitly here. Params set after
	# "include fastcgi_params" override the included defaults
	# (PHP-FPM keeps the last duplicate).
	location ~ ^/\.well-known/(.+)$ {
		include fastcgi_params;
		fastcgi_param PATH_INFO /.well-known/$1;
		fastcgi_param SCRIPT_FILENAME $document_root###WIKI_BASE_PATH|/###w/rest.php;
		fastcgi_param SCRIPT_NAME ###WIKI_BASE_PATH|/###w/rest.php;
		fastcgi_param REQUEST_URI ###WIKI_BASE_PATH|/###w/rest.php/.well-known/$1;
		fastcgi_param QUERY_STRING sfr=w&$args;
		fastcgi_pass unix:/var/run/php/php-fpm.sock;
	}

	# NOT a no-op, do not remove. Server-level rewrites run BEFORE location
	# matching, so without this line a /.well-known/* request never reaches
	# the location above: it falls through to the farm catch-all
	#     rewrite ^/([^/]*)/(.+)$ .../w/$2 last;
	# which mangles /.well-known/jwks.json into /w/jwks.json and dies with
	# 403 in "location /w { deny all; }". Rewriting the URI to itself with
	# "last" terminates the rewrite phase early, so location matching runs
	# on the unchanged URI and picks the /.well-known/ location above.
	rewrite ^(/\.well-known/.+)$ $1 last;

	rewrite ^/favicon\.ico$ ###WIKI_BASE_PATH|/###w/skins/BlueSpiceDiscovery/resources/images/favicon.ico last;
	rewrite ^###WIKI_BASE_PATH|/###robots\.txt$ ###WIKI_BASE_PATH|/###robots.txt last;
	rewrite ^###WIKI_BASE_PATH|/###_sp/(.*)$ ###WIKI_BASE_PATH|/###_sp/$1 last;
	rewrite ^###WIKI_BASE_PATH|/###webdav/(.*)$ ###WIKI_BASE_PATH|/###w/webdav.php/$1?$args last;
	rewrite ^###WIKI_BASE_PATH|/###([^/]*)/webdav/(.*)$ ###WIKI_BASE_PATH|/###w/webdav.php/$2?sfr=$1&$args last;
	rewrite ^###WIKI_BASE_PATH|/######WIKI_ARTICLE_PATH|wiki###/$ ###WIKI_BASE_PATH|/###w/index.php last;
	rewrite ^###WIKI_BASE_PATH|/######WIKI_ARTICLE_PATH|wiki###/(.*?).php/(.+)$ ###WIKI_BASE_PATH|/###w/$1.php?sfr=w&title=$2 last;
	rewrite ^###WIKI_BASE_PATH|/######WIKI_ARTICLE_PATH|wiki###/(.+)$ ###WIKI_BASE_PATH|/###w/index.php?title=$1&sfr=w last;
	rewrite ^###WIKI_BASE_PATH|/######WIKI_ARTICLE_PATH|wiki###/([^/]+)/?$ ###WIKI_BASE_PATH|/###w/index.php?title=$1&sfr=w last;
	rewrite ^###WIKI_BASE_PATH|/###w/(.*?)$ ###WIKI_BASE_PATH|/###w/$1?sfr=w last;
	rewrite ^###WIKI_BASE_PATH|/###([^/]*)/index.php/(.+)$ ###WIKI_BASE_PATH|/###w/$2.php?sfr=$1&title=$3 last;
	rewrite ^###WIKI_BASE_PATH|/###([^/]*)/(.*?).php/(.+)$ ###WIKI_BASE_PATH|/###w/$2.php/$3?sfr=$1 last;
	rewrite ^###WIKI_BASE_PATH|/###([^/]*)/(.*?).php ###WIKI_BASE_PATH|/###w/$2.php?sfr=$1 last;
	rewrite ^###WIKI_BASE_PATH|/###([^/]*)/###WIKI_ARTICLE_PATH|wiki###/$ ###WIKI_BASE_PATH|/###w/index.php?sfr=$1 last;
	rewrite ^###WIKI_BASE_PATH|/###([^/]*)/###WIKI_ARTICLE_PATH|wiki###$ ###WIKI_BASE_PATH|/###w/index.php?sfr=$1 last;
	rewrite ^###WIKI_BASE_PATH|/###([^/]*)/###WIKI_ARTICLE_PATH|wiki###/(.+)$ ###WIKI_BASE_PATH|/###w/index.php?title=$2&sfr=$1 last;
	rewrite ^###WIKI_BASE_PATH|/###([^/]*)/(.+)$ ###WIKI_BASE_PATH|/###w/$2 last;
	rewrite ^###WIKI_BASE_PATH|/###([^/]+)/?$ ###WIKI_BASE_PATH|/###w/index.php?sfr=$1 last;

	if (-f /data/maintenance) {
		return 503;
	}

	error_page 503 /maintenance.html;
	location = /maintenance.html {
		root /var/www/html;
		internal;
		add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
		add_header Pragma "no-cache";
		add_header Expires "0";
	}

	error_page 500 502 504 505 /error.html;
	location = /var/www/html {
		root /var/www/error_pages;
		internal;
		add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
		add_header Pragma "no-cache";
		add_header Expires "0";
	}

	location /w {
		deny all;
	}

	location ~ ^###WIKI_BASE_PATH|/###w/(api|dynamic_file|index|load|opensearch_desc|thumb_handler|thumb)\.php$ {
		include fastcgi.conf;
		fastcgi_split_path_info ^(.+?\.php)(/.+)$;
		fastcgi_param PATH_INFO $fastcgi_path_info;
		fastcgi_param SCRIPT_FILENAME $document_root/$fastcgi_script_name;
		fastcgi_pass unix:/var/run/php/php-fpm.sock;
	}

	location ~ ^(.*?)/(img_auth|nsfr_img_auth|rest|webdav)\.php(/.*?)$ {
		include fastcgi.conf;
		fastcgi_split_path_info ^(.+?\.php)(/.+)$;
		fastcgi_param PATH_INFO $fastcgi_path_info;
		fastcgi_param SCRIPT_FILENAME $document_root/$fastcgi_script_name;
		fastcgi_pass unix:/var/run/php/php-fpm.sock;
	}

	location ~ ###WIKI_BASE_PATH|/###w/BUILDINFO {
		allow all;
	}

	location ~ ^###WIKI_BASE_PATH|/###w/skins/BlueSpiceDiscovery/resources/images/favicon\.ico$ {
		allow all;
	}

	location ^~ ###WIKI_BASE_PATH|/###robots.txt {
		alias /data/bluespice/robots.txt;
	}

	location ^~ ###WIKI_BASE_PATH|/###_sp {
			alias /app/simplesamlphp/public;
				location ~^(?<prefix>###WIKI_BASE_PATH|/###_sp)(?<phpfile>.+?\.php)(?<pathinfo>/.*)?$ {
					include fastcgi_params;
					fastcgi_pass unix:/var/run/php/php-fpm.sock;
					fastcgi_param SCRIPT_FILENAME $document_root$phpfile;
					fastcgi_param SCRIPT_NAME ###WIKI_BASE_PATH|/###_sp$phpfile;
					fastcgi_param PATH_INFO $pathinfo if_not_empty;
				}
			break;
		}

	location ~ ^###WIKI_BASE_PATH|/###w/resources/(assets|lib|src) {
		add_header Cache-Control "public";
		expires 7d;
	}

	location ~ ^###WIKI_BASE_PATH|/###w/(skins|extensions)/.+\.(css|js|gif|jpg|jpeg|png|svg|woff|woff2|ttf)$ {
		add_header Cache-Control "public";
		expires 7d;
	}

	location = / {
		return 301 ###WIKI_BASE_PATH|/######WIKI_RETURN_PATH|wiki###;
	}
}