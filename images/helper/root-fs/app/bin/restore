#!/bin/bash
set -o errexit
set -o nounset
set -o pipefail

export BLUESPICE_TAR_BACKUP_DIRECTORY=${BLUESPICE_TAR_BACKUP_DIRECTORY:-'/backup/tar-backup'}
export BLUESPICE_DATABASE_DUMP_DIRECTORY=${BLUESPICE_DATABASE_DUMP_DIRECTORY:-'/data/wiki/db-dumps'}

# Parse command line arguments
RESTORE_MODE="full"
RESTORE_FARM_INSTANCE=""

for arg in "$@"; do
	if [[ "$arg" == "full" ]]; then
		RESTORE_MODE="full"
	elif [[ "$arg" =~ ^sfr=(.+)$ ]]; then
		RESTORE_MODE="instance"
		RESTORE_FARM_INSTANCE="${BASH_REMATCH[1]}"
	fi
done

# Find the most recent backup file
BACKUP_FILE=$(ls -t "${BLUESPICE_TAR_BACKUP_DIRECTORY}"/*.tar.gz 2>/dev/null | head -1)

if [[ -z "$BACKUP_FILE" ]]; then
	echo "ERROR: No backup file found in ${BLUESPICE_TAR_BACKUP_DIRECTORY}"
	exit 1
fi

# Determine what will be restored
HAS_FILES="unknown"
HAS_DATABASES="unknown"

if tar -tzf "$BACKUP_FILE" | grep -q "\.tar\.gz" 2>/dev/null; then
	HAS_FILES="yes"
fi

if [[ -f "${BLUESPICE_DATABASE_DUMP_DIRECTORY}/${DB_NAME}.mainDB.sql" ]] || \
   [[ -f "${BLUESPICE_DATABASE_DUMP_DIRECTORY}/${DB_NAME}.sql" ]]; then
	HAS_DATABASES="yes"
fi

echo ""
echo "#############################################"
echo "⚠️  RESTORE WARNING - Please Review Carefully"
echo "#############################################"
echo ""
echo "Backup file: $BACKUP_FILE"
echo ""

if [[ "$RESTORE_MODE" == "instance" ]]; then
	echo "MODE: Single Farm Instance Restore"
	echo "Instance: $RESTORE_FARM_INSTANCE"
	echo ""
	echo "This will restore:"
	echo "  • Wiki data (files) for instance: $RESTORE_FARM_INSTANCE"
	if [[ "$HAS_DATABASES" == "yes" ]]; then
		echo "  • Database tables for instance: $RESTORE_FARM_INSTANCE"
	fi
	echo "  • MongoDB collabpads sessions (if present)"
	echo ""
	echo "OLD DATA WILL BE DELETED for this instance only."
	echo "Other farm instances will NOT be affected."
else
	echo "MODE: Full Restore"
	echo ""
	echo "This will restore:"
	if [[ "$HAS_FILES" == "yes" ]]; then
		echo "  • All wiki data (files)"
	fi
	if [[ "$HAS_DATABASES" == "yes" ]]; then
		echo "  • All databases"
	fi
	echo "  • MongoDB collabpads (if present)"
	echo ""
	echo "WARNING: ALL existing wiki data and databases WILL BE DELETED and replaced."
fi

echo ""
echo "This operation cannot be undone."
echo ""
read -p "Are you sure you want to proceed? Type 'yes' to confirm: " confirmation

if [[ "$confirmation" != "yes" ]]; then
	echo "Restore cancelled."
	exit 0
fi

echo ""
echo "#############################################"
echo "🔄 Starting restore process"
echo "#############################################"
echo ""

export RESTORE_BACKUP_FILE="$BACKUP_FILE"
[[ -n "$RESTORE_FARM_INSTANCE" ]] && export RESTORE_FARM_INSTANCE="$RESTORE_FARM_INSTANCE"
/app/bin/restore-pipeline
