#!/bin/sh

# Load secrets; Omit subdirectories and non-uppercase filenames
for secret in $(find /run/secrets/ -maxdepth 1 -type f | grep -E '/[A-Z_]+$' | xargs -n1 basename); do
  # For grep:
  # - CHAT_BRIDGE_TOKEN
  # - CHAT_WIKI_ACCESS_TOKEN
  # - CHAT_WIKI_CHAT_TOKEN_SALT
  export "$secret"="$(cat /run/secrets/$secret)"
done

cd /app/chat
/app/chat/start.sh